{
    "editor.stickyTabStops": true,
    "workbench.preferredDarkColorTheme": "Rosé Pine Moon",
    "workbench.preferredLightColorTheme": "Rosé Pine Dawn",
    "window.autoDetectColorScheme": true,
    "editor.minimap.showSlider": "always",
    "editor.stickyScroll.maxLineCount": 15,
    "emmet.includeLanguages": {
        "nunjucks": "html"
    },
    "emmet.triggerExpansionOnTab": true,
    "files.associations": {
        "*.html": "html",
        "*.njk": "html",
        "renv.lock": "json"
    },
    "editor.fontFamily": "fd-conduit-term-nf, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.lineHeight": 1.25,
    "editor.wordWrap": "on",
    "terminal.integrated.fontLigatures.enabled": true,
    "chat.fontFamily": "IBM Plex Sans",
    "chat.editor.fontFamily": "fd-conduit-term-nf",
    "chat.editor.wordWrap": "on",
    "console.fontFamily": "fd-conduit-term-nf, Menlo, Monaco, 'Courier New', monospace",
    "r.bracketedPaste": true,
    // https://matthewdehaven.com/course-applied-economics-analysis-2025-Spring/guides/r-radian-terminal.html
    "r.rterm.mac": "/opt/homebrew/bin/arf",
    "r.plot.useHttpgd": true,
    "r.lsp.diagnostics": false,
    "quarto.render.renderOnSave": true,
    "markdown.preview.fontFamily": "IBM Plex Sans,-apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "claudeCode.useTerminal": true,
    "workbench.sideBar.experimental.fontFamily": "fd-conduit-term",
    "workbench.experimental.fontFamily": "fd-conduit-term",
    "workbench.statusBar.experimental.fontFamily": "fd-conduit-term",
    "workbench.tabs.experimental.fontFamily": "fd-conduit-term",
    "workbench.activityBar.experimental.fontFamily": "fd-conduit-term",
    "diffEditor.ignoreTrimWhitespace": false,
    "workbench.iconTheme": "rose-pine-symbols",
    "rose-pine-symbols.folderStyle": "symbols"
}
